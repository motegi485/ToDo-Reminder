name = "todo-reminder-api"
main = "workers/index.ts"
compatibility_date = "2024-09-23"
compatibility_flags = ["nodejs_compat"]
workers_dev = true

[[d1_databases]]
binding = "DB"
database_name = "todo-reminder-db"
# `npx wrangler d1 create todo-reminder-db` の出力 database_id をここに貼る
database_id = "<your-d1-database-id>"

[triggers]
crons = ["* * * * *", "0 3 * * *"]

[vars]
# 本番フロントのオリジンに合わせる
ALLOWED_ORIGIN = "https://todo-reminder.pages.dev"
